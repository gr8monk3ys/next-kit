{
  "name": "@gr8monk3ys/next-kit",
  "version": "0.3.0",
  "description": "Server-side building blocks for Next.js apps: fixed-window rate limiting with pluggable stores, a lazy Stripe client with webhook/checkout/portal helpers, and auth guards for Better Auth and Clerk.",
  "license": "MIT",
  "author": "Lorenzo Scaturchio",
  "repository": {
    "type": "git",
    "url": "https://github.com/gr8monk3ys/next-kit.git"
  },
  "homepage": "https://github.com/gr8monk3ys/next-kit#readme",
  "keywords": [
    "nextjs",
    "rate-limit",
    "stripe",
    "better-auth",
    "clerk",
    "redis",
    "typescript"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/index.d.ts",
      "import": "./src/rate-limit/index.ts",
      "require": "./dist/rate-limit/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe/index.d.ts",
      "import": "./src/stripe/index.ts",
      "require": "./dist/stripe/index.js"
    },
    "./auth/better-auth": {
      "types": "./dist/auth/better-auth.d.ts",
      "import": "./src/auth/better-auth.ts",
      "require": "./dist/auth/better-auth.js"
    },
    "./auth/clerk": {
      "types": "./dist/auth/clerk.d.ts",
      "import": "./src/auth/clerk.ts",
      "require": "./dist/auth/clerk.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check": "bun run lint && bun run typecheck && bun run depcruise && bun run test && bun run build"
  },
  "peerDependencies": {
    "@clerk/nextjs": ">=6",
    "better-auth": ">=1",
    "next": ">=14",
    "stripe": ">=17"
  },
  "peerDependenciesMeta": {
    "@clerk/nextjs": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.27",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.2",
    "pg": "^8.23.1",
    "simple-git-hooks": "^2.14.0",
    "stripe": "^22.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged && bun run typecheck"
  },
  "lint-staged": {
    "*.{ts,js,cjs}": "eslint"
  }
}
